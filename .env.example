# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase access. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The only account allowed to use the admin area.
ADMIN_EMAIL=you@example.com

# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=personal-notes
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Optional request-signing and operational settings
R2_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_FILE_SIZE_MB=10
