# Sao chép file này thành .env.local. Không điền secret thật vào .env.example.
# Các giá trị để trống giữ ứng dụng ở chế độ demo cho tới khi bạn cấu hình dịch vụ.

# URL công khai của website. Production: thay bằng domain HTTPS thật, không có dấu / cuối.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project URL và Publishable key được phép dùng ở trình duyệt.
# Ví dụ URL: https://abcdefghijklmnop.supabase.co
# Ví dụ key: sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — Secret key chỉ dành cho server, có quyền cao và bypass RLS.
# Ví dụ: sb_secret_...
SUPABASE_SECRET_KEY=

# Email duy nhất được phép truy cập trang quản trị và phải khớp Supabase Auth.
ADMIN_EMAIL=

# Cloudflare R2 — tất cả đều là server-only. Token nên có Object Read & Write
# và chỉ được cấp quyền cho đúng bucket media của dự án.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Để trống khi dùng bucket private (khuyến nghị). Chỉ điền URL CDN/domain của
# một bucket public tách riêng nếu bạn chủ động triển khai phương án đó.
R2_PUBLIC_BASE_URL=

# Tùy chọn: signed URL hợp lệ 60–3600 giây; mặc định 900 giây.
R2_SIGNED_URL_TTL_SECONDS=900

# Tùy chọn: trần upload server trên 0 đến 100 MB; profile từng nhóm vẫn có giới hạn thấp hơn.
UPLOAD_MAX_FILE_SIZE_MB=10
